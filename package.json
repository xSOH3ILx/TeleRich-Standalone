{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/build-worker.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/worker.test.mjs tests/build.test.mjs tests/runtime.test.mjs",
    "test:browser": "playwright test",
    "check": "npm run build && npm test && npm run test:browser && npm audit --audit-level=low",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "@types/katex": "^0.16.8",
    "clsx": "2.1.1",
    "katex": "^0.18.7",
    "lucide-react": "^1.43.0",
    "marked": "^18.0.12",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "wrangler": "4.149.0",
    "esbuild": "0.28.2",
    "@playwright/test": "1.64.0",
    "miniflare": "5.20261006.1-alpha"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  }
}
