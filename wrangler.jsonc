{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telerich",
  "main": "public/worker.js",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [{ "name": "BOT_STATE", "class_name": "BotState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BotState"] }],
  "observability": {
    "enabled": true
  }
}
