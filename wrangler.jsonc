{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telerich",
  "main": "public/worker.js",
  "compatibility_date": "2026-09-01",
  // Create telerich-library in R2 first, then enable this binding:
   "r2_buckets": [{ "binding": "MEDIA_LIBRARY", "bucket_name": "telerich-library" }],
  "durable_objects": {
    "bindings": [{ "name": "BOT_STATE", "class_name": "BotState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BotState"] }],
  "observability": {
    "enabled": true
  }
}
